# Host layout
DEV_USER=developer
PROJECTS_DIR=/home/developer/projects

# Packages
INSTALL_DOCKER=1
INSTALL_OPENCODE=1
INSTALL_OPENCODE_SERVICE=1

# OpenCode
OPENCODE_PORT=4096
OPENCODE_USERNAME=opencode
# Never commit the password. Leave empty and install-opencode-service.sh will generate one.
OPENCODE_SERVER_PASSWORD=
OPENCODE_INSTALL_URL=https://opencode.ai/install

# Remote host tuning
CREATE_SWAP_GB=0

# Firewall. Keep disabled until SSH key login is verified in a second terminal.
CONFIGURE_UFW=0
ALLOW_WEB=1
SSH_ALLOW_CIDRS=

# Client helper
SSH_ALIAS=dev-vps
SSH_HOST=dev.example.com
SSH_PORT=22
SSH_USER=developer
SSH_IDENTITY_FILE=~/.ssh/id_ed25519
CLIENT_PROJECT_DIR=/home/developer/projects
